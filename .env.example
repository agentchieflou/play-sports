# Copy to .env and fill in values. See AGENTS.md > "Free-tier / local model slots".
# Read by tools/orchestrator (Track P and Core 25): `python -m tools.orchestrator models` shows
# which tiers each value enables; `delegate` sends a task down the free-tier "bridge" chain.

# Local Ollama instance (no cost, works offline).
OLLAMA_HOST=http://localhost:11434

# Google AI Studio free tier (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# OpenRouter free-tier models (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
